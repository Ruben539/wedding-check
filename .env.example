# Copiar como .env para desarrollo local (npx expo start). Las builds usan los perfiles de eas.json.

# DEV o PRD
EXPO_PUBLIC_ENV=DEV

# API del sistema de confirmaciones
EXPO_PUBLIC_API_URL=http://67.205.153.141/api
# Producción: https://confirmaciones.factosystem.com.py/api

# Solo en DEV: permite acreditar y marcar el timeline cualquier día (ignorado en PRD)
EXPO_PUBLIC_SKIP_EVENT_DATE_CHECK=false
